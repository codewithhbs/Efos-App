{
  "expo": {
    "name": "EFOS",
    "slug": "efos-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/adaptive-icon.png",
    "scheme": "efos",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/ic_launcher.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.efos.course",
      "buildNumber": "1",
      "icon": "./assets/adaptive-icon.png",
      "googleServicesFile": "./GoogleService-Info.plist",
      "associatedDomains": [
        "applinks:www.efos.in",
        "applinks:efos.in"
      ],
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch"
        ],
        "UIUserNotificationAlertStyle": "alert"
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
  
"android": {
  "package": "com.efos.courses",
  "adaptiveIcon": {
    "foregroundImage": "./assets/adaptive-icon.png",
    "backgroundColor": "#ffffff"
  },
  "googleServicesFile": "./google-services.json",
  "blockedPermissions": [
    "android.permission.READ_MEDIA_IMAGES",
    "android.permission.READ_MEDIA_VIDEO",
    "android.permission.READ_EXTERNAL_STORAGE"
  ],
  "permissions": [
    "POST_NOTIFICATIONS",
    "VIBRATE"
  ],
  "intentFilters": [
    {
      "action": "VIEW",
      "autoVerify": false,
      "data": [
        {
          "scheme": "efos"
        }
      ],
      "category": [
        "BROWSABLE",
        "DEFAULT"
      ]
    },
    {
      "action": "VIEW",
      "autoVerify": true,
      "data": [
        {
          "scheme": "https",
          "host": "www.efos.in",
          "pathPrefix": "/"
        },
        {
          "scheme": "https",
          "host": "efos.in",
          "pathPrefix": "/"
        }
      ],
      "category": [
        "BROWSABLE",
        "DEFAULT"
      ]
    }
  ],
  "edgeToEdgeEnabled": true
}
,
    "web": {
      "favicon": "./assets/adaptive-icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#FB2B37"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "buildReactNativeFromSource": true,
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBMessaging"
            ]
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging"
    ],
    "extra": {
      "eas": {
        "projectId": "380e3e33-6978-4d33-aad5-85dfd9dfa8e7"
      }
    },
    "owner": "hbsdevelopersteam"
  }
}