{
  "cli": {
    "version": ">= 16.6.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": { "APP_ENV": "development" }
    },
    "development-device": {
      "extends": "development",
      "ios": { "simulator": false }
    },
    "preview": {
      "distribution": "internal"
    },
    "simulator": {
      "distribution": "internal",
      "ios": { "simulator": true }
    },
  "production": {
      "distribution": "store",
      "autoIncrement": true,
  "credentialsSource": "local"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "info@hovermedia.in", 
        "ascAppId": "6825653323", 
        "appleTeamId": "UM556J5XWF" 
      }
    }
  }
}