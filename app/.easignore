    # Git history and metadata
.git/
.gitignore

# Expo generated cache
.expo/
.expo-shared/

# Previous generated app bundles
EFOS.app/
*.ipa
*.app/
*.dSYM/
*.dSYM.zip

# Build output
build/
dist/
coverage/
web-build/

# Temporary files and logs
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.tmp
*.temp

# Test and development artifacts
__tests__/
*.test.js
*.test.ts
*.spec.js
*.spec.ts

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# Environment files (keep secrets out of build uploads)
.env
.env.*
!.env.example

# Local credentials — never upload these as project files
credentials.json
credentials/
*.p12
*.mobileprovision

# Local platform build artifacts
ios/build/
android/.gradle/
android/build/
android/app/build/
android/app/.cxx/

# Local dependency and package caches
npm-cache/
.yarn/cache/
.pnpm-store/